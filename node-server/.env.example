DATABASE_URL=""
DIRECT_URL=""

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=

# Internal FastAPI Compute Host
FASTAPI_URL=http://127.0.0.1:8000

# Label-mask scan pipeline (SAM2 unwrap -> per-face OCR -> compliance).
# One toggle, two ways (CLI wins over env):
#   Terminal: npm start -- --mask-scan   (enable) / --no-mask-scan (disable)
#   Env:      ENABLE_MASK_SCAN=true
# OFF (default): photo scans run the direct-OCR pipeline, video uploads are rejected with 503.
# ON: image and video uploads are routed through FastAPI POST /api/v1/video/unwrap first.
# Requires the FastAPI server with its SAM2 checkpoint:
#   cd server && python scripts/download_checkpoint.py
ENABLE_MASK_SCAN=false

# Logging: 
warn: hides routine request logs; use info or debug when troubleshooting
info: shows all requests and responses
debug: shows all requests, responses, and internal server logs
LOG_LEVEL=warn

ENABLE_MASK_SCAN=true
false : to disable the mask scan pipeline (default)
